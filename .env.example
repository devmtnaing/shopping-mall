# Copy to .env and fill in what you need. Every value is optional.
# Password that signs someone in as the mall's host (gold name, /announce).
HOST_SECRET=
# Reports are always logged; set this to also POST them (JSON) somewhere, e.g. a chat webhook.
REPORT_WEBHOOK=
# People per room before new arrivals overflow into main-2, main-3, …
ROOM_CAPACITY=100
# Postgres for live content. docker compose sets this for you; for pnpm dev:server run `pnpm db:up` and use:
# DATABASE_URL=postgres://mall:mall@localhost:5433/mall
# Uploads (S3-compatible). docker compose runs SeaweedFS; for pnpm dev:server after `pnpm db:up`:
# S3_ENDPOINT=http://localhost:8333
# S3_BUCKET=mall
# S3_ACCESS_KEY_ID=mall
# S3_SECRET_ACCESS_KEY=mall-secret
# Port the mall is served on (http://localhost:<port>).
WEB_PORT=8080
