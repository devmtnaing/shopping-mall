# A template: the nginx image fills in ${PORT} and ${API_UPSTREAM} from the environment at start
# (compose: 80 and server:8787; Railway: its PORT and server.railway.internal:8787).

# The visitor's IP, for the server's per-IP limits, taken from where CLIENT_IP_FROM says
# (docs/deploy.md, "Behind a proxy or CDN"). client-ip.envsh picks a default at start.
#   direct           the connection's own address; ignores headers, which visitors could fake
#   x-real-ip        X-Real-IP, set by the proxy in front (Railway's edge)
#   cloudflare       CF-Connecting-IP, with Cloudflare's proxy in front
#   x-forwarded-for  the last address in X-Forwarded-For: the one the proxy in front added
map $http_x_real_ip $from_real_ip {
  "" $remote_addr;
  default $http_x_real_ip;
}
map $http_cf_connecting_ip $from_cloudflare {
  "" $remote_addr;
  default $http_cf_connecting_ip;
}
map $http_x_forwarded_for $from_forwarded {
  "~(?:^|,)\s*([^,\s]+)\s*$" $1;
  default $remote_addr;
}
map "${CLIENT_IP_FROM}" $client_ip {
  x-real-ip $from_real_ip;
  cloudflare $from_cloudflare;
  x-forwarded-for $from_forwarded;
  default $remote_addr;
}

server {
  listen ${PORT};
  listen [::]:${PORT};
  root /usr/share/nginx/html;
  # look the server up per request (it may start after us, or move), with the container's resolver
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
  set $api http://${API_UPSTREAM};
  # asset uploads go through to the server (models are up to 25 MB)
  client_max_body_size 30m;

  # content-hashed build files (name-AbCd1234.js) never change: cache for a year.
  # Un-hashed files (the mall model under /assets/mall/) are revalidated instead.
  location ~* "^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2|png|svg|jpg|webp)$" {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  # multiplayer server on the same origin
  location /ws {
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Client-IP $client_ip;
    proxy_read_timeout 1h;
  }
  # the shop directory is rendered live by the server from the database
  location = /directory/ {
    proxy_pass $api;
  }
  location ~ ^/(health|host-token|api/|files/) {
    proxy_pass $api;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Client-IP $client_ip;
  }

  gzip on;
  gzip_types application/javascript text/css application/json image/svg+xml application/octet-stream model/gltf-binary;
}
