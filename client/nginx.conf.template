# A template: the nginx image fills in ${PORT} and ${API_UPSTREAM} from the environment at start
# (compose: 80 and server:8787; Railway: its PORT and server.railway.internal:8787).

# The visitor's IP, for the server's per-IP limits. Railway's edge sets X-Real-IP to it (and
# overwrites whatever the visitor sent). With Cloudflare's proxy in front, that's a Cloudflare
# address shared by many visitors, so set CLIENT_IP_FROM=cloudflare on this service and it uses
# CF-Connecting-IP instead. (Only then: without Cloudflare in front, anyone could fake that header.)
# Run bare (docker compose), neither header is there and it's the socket's address.
map $http_x_real_ip $edge_ip {
  "" $remote_addr;
  default $http_x_real_ip;
}
map $http_cf_connecting_ip $cloudflare_ip {
  "" $edge_ip;
  default $http_cf_connecting_ip;
}
map "${CLIENT_IP_FROM}" $client_ip {
  cloudflare $cloudflare_ip;
  default $edge_ip;
}

server {
  listen ${PORT};
  listen [::]:${PORT};
  root /usr/share/nginx/html;
  # look the server up per request (it may start after us, or move), with the container's resolver
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
  set $api http://${API_UPSTREAM};
  # asset uploads go through to the server (models are up to 25 MB)
  client_max_body_size 30m;

  # content-hashed build files (name-AbCd1234.js) never change: cache for a year.
  # Un-hashed files (the mall model under /assets/mall/) are revalidated instead.
  location ~* "^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2|png|svg|jpg|webp)$" {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  # multiplayer server on the same origin
  location /ws {
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Client-IP $client_ip;
    proxy_read_timeout 1h;
  }
  # the shop directory is rendered live by the server from the database
  location = /directory/ {
    proxy_pass $api;
  }
  location ~ ^/(health|host-token|api/|files/) {
    proxy_pass $api;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Client-IP $client_ip;
  }

  gzip on;
  gzip_types application/javascript text/css application/json image/svg+xml application/octet-stream model/gltf-binary;
}
