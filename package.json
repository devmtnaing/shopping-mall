{
  "name": "plaza",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @plaza/client dev",
    "dev:server": "pnpm --filter @plaza/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@plaza/shared": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
