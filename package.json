{
  "name": "shopping-mall",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @shopping-mall/client dev",
    "dev:server": "pnpm --filter @shopping-mall/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tools",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "size": "node tools/size.ts",
    "perf": "node tools/perf.ts",
    "a11y": "node tools/a11y.ts",
    "screenshots": "node tools/screenshots.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm size",
    "greybox": "node tools/greybox/build.ts && node tools/bake-navgrid.ts",
    "navgrid": "node tools/bake-navgrid.ts",
    "assets": "node tools/assets/avatars.ts && node tools/assets/props.ts",
    "bots": "node tools/bots.ts",
    "db:up": "docker compose up -d postgres storage",
    "db:migrate": "node server/src/db/migrate-cli.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@shopping-mall/shared": "workspace:*",
    "@types/node": "^24.19.0",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  }
}
