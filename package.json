{
  "name": "plaza",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @plaza/client dev",
    "dev:server": "pnpm --filter @plaza/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tools",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "size": "node tools/size.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm size",
    "greybox": "node tools/greybox/build.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@gltf-transform/core": "^4.5.0",
    "@plaza/shared": "workspace:*",
    "@types/node": "^24.19.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  }
}
